# Vercel 프로젝트 env에도 같은 값을 넣는다. 전부 서버 전용이라
# NEXT_PUBLIC_ 접두사가 붙은 게 하나도 없다 — 브라우저로 나가면 안 되는 값들이다.

# Neon 무료 Postgres. 없으면 데모 데이터로 화면만 돈다.
DATABASE_URL=postgresql://<user>:<pw>@<host>/<db>?sslmode=require

# 요약용. 개인 키를 쓰고 월 지출 한도를 걸어 둔다.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Actions가 /api/collect를 부를 때 쓰는 값. 아무 랜덤 문자열이면 된다.
CRON_SECRET=

# 화면 접근 비밀번호. 비워 두면 게이트가 꺼진다(로컬 개발용).
# 프로덕션에서는 반드시 채운다 — 안 채우면 URL만 아는 사람이 남의 큐를 비울 수 있다.
APP_PASSWORD=
