# Vercel 프로젝트 env에도 같은 값을 넣는다. 전부 서버 전용이라
# NEXT_PUBLIC_ 접두사가 붙은 게 하나도 없다 — 브라우저로 나가면 안 되는 값들이다.

# Neon 무료 Postgres. 없으면 데모 데이터로 화면만 돈다.
DATABASE_URL=postgresql://<user>:<pw>@<host>/<db>?sslmode=require

# 요약용. 개인 키를 쓰고 월 지출 한도를 걸어 둔다.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Actions가 /api/collect를 부를 때 쓰는 값. 아무 랜덤 문자열이면 된다.
# 세션 서명 키(SESSION_SECRET)를 안 넣으면 이 값이 그 역할까지 겸한다.
CRON_SECRET=

# 가입에 필요한 초대코드(07-30 완전 개인화). 지인 소수 초대제라 이메일 인증이 없다.
# 비워 두면 아무도 가입할 수 없다 — 이미 만든 계정의 로그인은 된다.
INVITE_CODE=

# 세션 쿠키 서명 키. 비워 두면 CRON_SECRET을 쓴다(env를 늘리지 않으려고).
# 둘 다 비면 게이트가 통째로 꺼지고 1번 유저로 본다 — 로컬에서 화면만 볼 때의 경로다.
SESSION_SECRET=
